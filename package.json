{
  "name": "bit2208-blog",
  "version": "1.0.0",
  "description": "A modern, offline-first blog application built with React, TypeScript, and Firebase",
  "private": true,
  "type": "module",
  "author": "Evans",
  "license": "MIT",
  "keywords": [
    "react",
    "typescript",
    "firebase",
    "blog",
    "offline-first",
    "pwa",
    "vite",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/bit2208-blog"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest --passWithNoTests",
    "test:e2e": "NODE_OPTIONS=--require=./scripts/playwright-require.js playwright test",
    "test:e2e:dev": "NODE_OPTIONS=--require=./scripts/playwright-require.js playwright test",
    "test:e2e:ci": "NODE_OPTIONS=--require=./scripts/playwright-require.js CI=1 playwright test",
    "ci": "npm run lint && npm test -- --runInBand && npm run test:e2e:ci",
    "emulators:start": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "emulators:stop": "kill $(lsof -t -i:9099,8080,9199,4000) 2>/dev/null || true"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "firebase": "^12.5.0",
    "lucide-react": "^0.553.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.9.5",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-tools": "^14.24.1",
    "globals": "^16.4.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.56.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "web-streams-polyfill": "^4.2.0"
  }
}
